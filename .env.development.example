# =============================================================================
# TalentGeenie — Frontend Development Environment
# =============================================================================
# Vite automatically loads this file in development mode (npm run dev).
# Points the frontend at the self-hosted Supabase stack.
#
# After running `make up` or `./scripts/start-dev.sh`, these values are correct.
# =============================================================================

# Supabase API Gateway (Kong)
VITE_SUPABASE_URL=http://localhost:8000

# Anon/public key — copy from .env.supabase (the ANON_KEY value)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-from-env-supabase

# Project identifier (used for some Supabase client paths)
VITE_SUPABASE_PROJECT_ID=local
