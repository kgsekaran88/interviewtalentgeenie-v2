# =============================================================================
# TalentGeenie — Self-Hosted Supabase Environment Variables
# =============================================================================
# Copy this file to .env.supabase and fill in your values.
#
#   cp .env.supabase.example .env.supabase
#   ./scripts/generate-keys.sh --append .env.supabase
#   docker compose -f docker-compose.supabase.yml --env-file .env.supabase up -d
#
# NEVER commit .env.supabase to version control.
# =============================================================================

# =============================================================================
# 1. JWT / AUTH KEYS
# =============================================================================
# Generate these with: ./scripts/generate-keys.sh
# JWT_SECRET must be at least 32 characters.

JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
ANON_KEY=your-generated-anon-key
SERVICE_ROLE_KEY=your-generated-service-role-key

# JWT token expiry in seconds (default: 1 hour)
JWT_EXP=3600

# =============================================================================
# 2. DATABASE
# =============================================================================
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# =============================================================================
# 3. API GATEWAY (Kong)
# =============================================================================
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# External URL — how clients reach the API gateway
# In local dev: http://localhost:8000
# In production: https://api.yourdomain.com
API_EXTERNAL_URL=http://localhost:8000

# =============================================================================
# 4. AUTH (GoTrue)
# =============================================================================
# The URL your frontend app runs on (for redirects after login/signup)
SITE_URL=http://localhost:5173

# Comma-separated list of additional allowed redirect URLs
ADDITIONAL_REDIRECT_URLS=http://localhost:8080

# Signup controls
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_SIGN_INS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true

# SMTP — Email delivery
# For local dev, leave defaults (uses inbucket or no-op).
# For production, configure a real SMTP server or Resend SMTP.
SMTP_ADMIN_EMAIL=admin@talentgeenie.local
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=TalentGeenie

# =============================================================================
# 5. POSTGREST
# =============================================================================
# Schemas exposed via REST API
PGRST_DB_SCHEMAS=public,storage,graphql_public

# =============================================================================
# 6. REALTIME
# =============================================================================
# Secret key base for Phoenix/Realtime (generate with: openssl rand -base64 48)
REALTIME_SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# =============================================================================
# 7. STUDIO (Dashboard)
# =============================================================================
STUDIO_PORT=3000
STUDIO_DEFAULT_ORGANIZATION=TalentGeenie
STUDIO_DEFAULT_PROJECT=InterviewTalentGeenie

# =============================================================================
# 8. IMAGE TRANSFORMATION
# =============================================================================
IMGPROXY_ENABLE_WEBP_DETECTION=true

# =============================================================================
# 9. FRONTEND (Vite build args — used by docker-compose.yml for app build)
# =============================================================================
# These should point to your Kong gateway URL + the generated ANON_KEY
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-generated-anon-key
VITE_SUPABASE_PROJECT_ID=local

# =============================================================================
# 10. OPTIONAL — Logging / Analytics
# =============================================================================
# LOGFLARE_API_KEY=placeholder
